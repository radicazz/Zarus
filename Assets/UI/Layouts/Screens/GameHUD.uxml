<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" 
       xsi="http://www.w3.org/2001/XMLSchema-instance" 
       engine="UnityEngine.UIElements" 
       editor="UnityEditor.UIElements" 
       noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" 
       editor-extension-mode="False">
    
    <ui:Style src="../../Styles/MainTheme.uss" />
    
    <!-- Split HUD - Top & Bottom -->
    <ui:VisualElement name="GameHUDRoot" class="split-hud-container">
        
        <!-- Top Bar -->
        <ui:VisualElement name="TopBar" class="top-hud">
            
            <!-- Left Section - Time & Day (Inline) -->
            <ui:VisualElement name="TimeSection" class="top-hud__section" style="flex-direction: row; align-items: center;">
                <ui:Label name="TimerValue" text="Day 1" class="top-hud__primary-text" style="margin-right: 12px;" />
                <ui:Label name="TimerSubValue" text="08:30 | 1.5x" class="top-hud__secondary-text" style="margin-right: 8px;" />
                <ui:Label name="TimerDetail" text="Jan 1st 2025" class="top-hud__tertiary-text" />
            </ui:VisualElement>
            
            <!-- Center Section - Budget & Progress -->
            <ui:VisualElement name="CenterSection" class="top-hud__section" style="flex-direction: row; align-items: center; justify-content: center; flex: 1;">
                <!-- Budget -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-right: 24px;">
                    <ui:Label text="BUDGET" class="top-hud__hint" style="margin-right: 6px; margin-bottom: 0;" />
                    <ui:Label name="ZarBalanceLabel" text="R 1,000" class="top-hud__primary-text" />
                </ui:VisualElement>
                <!-- Cure Progress -->
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label text="CURE" class="top-hud__hint" style="margin-right: 6px; margin-bottom: 0;" />
                    <ui:Label name="CureProgressDetailsLabel" text="0%" class="top-hud__secondary-text" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- Right Section - Game Controls (Inline) -->
            <ui:VisualElement name="GameControlsSection" class="top-hud__section--right" style="align-items: center;">
                <ui:Label text="ESC - Menu" class="top-hud__hint" style="margin-right: 8px;" />
                <ui:Button name="OpenUpgradesButton" text="Research Lab" class="top-hud__button" style="margin-right: 0;" />
            </ui:VisualElement>
            
        </ui:VisualElement>
        
        <!-- Bottom Bar -->
        <ui:VisualElement name="BottomBar" class="bottom-hud">
            
            <!-- Left Section - Province Info -->
            <ui:VisualElement name="ProvinceSection" class="bottom-hud__section" style="flex-direction: row; align-items: center;">
                <ui:Label text="Province Details" class="bottom-hud__secondary-text" />
            </ui:VisualElement>
            
            <!-- Center Section - Main Action Area -->
            <ui:VisualElement name="ActionSection" class="bottom-hud__section--center" style="align-items: center;">
                <ui:Label text="Select province for details" class="bottom-hud__status-hint" />
            </ui:VisualElement>
            
            <!-- Right Section - Action Buttons -->
            <ui:VisualElement name="ButtonSection" class="bottom-hud__section--right" style="align-items: center; justify-content: flex-end;">
                <ui:Label text="Ready" class="bottom-hud__secondary-text" />
            </ui:VisualElement>
            
        </ui:VisualElement>
        
        <!-- Income Toast Notification -->
        <ui:VisualElement name="IncomeToast" class="income-toast">
            <ui:Label name="IncomeToastText" text="+R 50 Daily Income" class="income-toast__text" />
        </ui:VisualElement>
        
        <!-- Modal Host for Overlays -->
        <ui:VisualElement name="ModalHost" class="modal-host hidden" />
        
    </ui:VisualElement>
    
</ui:UXML>
