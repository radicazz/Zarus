<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" 
       xsi="http://www.w3.org/2001/XMLSchema-instance" 
       engine="UnityEngine.UIElements" 
       editor="UnityEditor.UIElements" 
       noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" 
       editor-extension-mode="False">
    
    <ui:Style src="../../Styles/MainTheme.uss" />
    
    <!-- HUD Root -->
    <ui:VisualElement name="GameHUDRoot" class="split-hud-container">
        
        <!-- Top Bar -->
        <ui:VisualElement name="TopBar" class="top-hud">
            
            <!-- Left Section - Time & Day (Inline) -->
            <ui:VisualElement name="TimeSection" class="top-hud__section" style="flex-direction: row; align-items: center;">
                <ui:Label name="TimerValue" text="Day 1" class="top-hud__primary-text" style="margin-right: 12px;" />
                <ui:Label name="TimerSubValue" text="08:30 | 1.5x" class="top-hud__secondary-text" style="margin-right: 8px;" />
                <ui:Label name="TimerDetail" text="Jan 1st 2025" class="top-hud__tertiary-text" />
            </ui:VisualElement>
            
            <!-- Center Section - Budget only -->
            <ui:VisualElement name="CenterSection" class="top-hud__section" style="flex-direction: row; align-items: center; justify-content: center; flex: 1;">
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label text="BUDGET" class="top-hud__hint" style="margin-right: 6px; margin-bottom: 0;" />
                    <ui:Label name="ZarBalanceLabel" text="R 1,000" class="top-hud__primary-text" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- Right Section - Status Chips + ESC hint -->
            <ui:VisualElement name="GameControlsSection" class="top-hud__section--right" style="flex-direction: column; align-items: flex-end;">
                <ui:VisualElement class="top-hud__chips">
                    <ui:Label name="InfectionSummaryLabel" text="Infected 0%" class="top-hud__chip" />
                    <ui:Label name="CureSummaryLabel" text="Cure 0%" class="top-hud__chip top-hud__chip--accent" />
                </ui:VisualElement>
                <ui:Label text="ESC - Menu" class="top-hud__hint" style="margin-top: 4px;" />
            </ui:VisualElement>
            
        </ui:VisualElement>
        
        <!-- Income Toast Notification -->
        <ui:VisualElement name="IncomeToast" class="income-toast">
            <ui:Label name="IncomeToastText" text="+R 50 Daily Income" class="income-toast__text" />
        </ui:VisualElement>
        
        <!-- Modal Host for Overlays -->
        <ui:VisualElement name="ModalHost" class="modal-host hud-modal-host hidden" />
        
    </ui:VisualElement>
    
</ui:UXML>
