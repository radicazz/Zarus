<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
        xsi="http://www.w3.org/2001/XMLSchema-instance"
        engine="UnityEngine.UIElements"
        editor="UnityEditor.UIElements"
        noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
        editor-extension-mode="False">

    <ui:Style src="../../Styles/MainTheme.uss" />

    <ui:VisualElement name="StartMenuRoot" class="overlay-backdrop">
        <ui:VisualElement name="MenuPanel" class="menu-panel overlay-section slide-up">
            <ui:Label name="GameTitle" class="menu-title" text="ZARUS" />
            <ui:Label name="GameSubtitle" class="menu-subtitle" text="Navigate South Africa's provinces and master the map." />

            <ui:VisualElement name="ButtonGroup" class="menu-button-group">
                <ui:Button name="StartButton" class="button button--primary menu-button" text="Start" />
                <ui:Button name="TutorialButton" class="button button--secondary menu-button" text="Tutorial" />
                <ui:Button name="SettingsButton" class="button button--secondary menu-button" text="Settings" />
                <ui:Button name="ExitButton" class="button button--danger menu-button" text="Exit" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="TutorialPanel" class="panel overlay-section overlay-section--spaced tutorial-panel hidden">
            <ui:Label class="menu-title" text="How to Play" style="font-size: 28px;" />
            <ui:Label class="menu-subtitle tutorial-panel__intro" text="Zarus is a strategic response sim. Keep infections contained while balancing research and budget." />

            <ui:VisualElement class="tutorial-panel__section">
                <ui:Label class="tutorial-panel__heading" text="Core Controls" />
                <ui:Label class="tutorial-panel__text" text="• Left mouse selects provinces and UI buttons." />
                <ui:Label class="tutorial-panel__text" text="• Mouse wheel zooms, hold right mouse to pan the map." />
                <ui:Label class="tutorial-panel__text" text="• ESC pauses the game, opens settings, or returns to the menu." />
            </ui:VisualElement>

            <ui:VisualElement class="tutorial-panel__section">
                <ui:Label class="tutorial-panel__heading" text="Objectives" />
                <ui:Label class="tutorial-panel__text" text="• Hover a province to see infection, population, and threat data." />
                <ui:Label class="tutorial-panel__text" text="• Deploy outposts to slow outbreaks and spend ZAR wisely." />
                <ui:Label class="tutorial-panel__text" text="• Research upgrades from the HUD to boost cure progress." />
            </ui:VisualElement>

            <ui:Button name="CloseTutorialButton" class="button button--secondary menu-button tutorial-panel__close" text="Close" />
        </ui:VisualElement>

        <ui:VisualElement name="SettingsPanelHost" class="panel overlay-section overlay-section--spaced hidden settings-panel-host" />
    </ui:VisualElement>

</ui:UXML>
